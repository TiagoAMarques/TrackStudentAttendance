PILOT_MODE=false
PILOT_PUBLIC_ORIGIN=http://192.168.1.100:3000
PILOT_TEACHER_CODE=choose-a-strong-access-code
PILOT_TEACHER_SECRET=generate-a-long-random-secret
# Optional JSON array: id, displayName, email, code. Keep actual codes out of source.
PILOT_TEACHERS_JSON=[]
# Comma-separated configured teacher IDs; if omitted the first configured teacher administers the pool.
# PILOT_ADMIN_IDS=local-pilot-teacher
# Production defaults: ID numbers alone are never authentication.
PILOT_ALLOW_UNVERIFIED_STUDENTS=false
# Enable only while hosted behind the Sites identity dispatcher, never on a bare VM.
AUTH_PROVIDER=disabled

# University OpenID Connect (used only when AUTH_PROVIDER=oidc).
# Keep real client/session secrets outside Git and use exact URLs registered with the identity provider.
PULSE_PUBLIC_ORIGIN=https://pulse.campus.ciencias.ulisboa.pt
OIDC_ISSUER_URL=https://identity.example.edu
OIDC_CLIENT_ID=pulse
OIDC_CLIENT_SECRET=replace-through-a-secure-channel
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=https://pulse.campus.ciencias.ulisboa.pt/api/auth/callback/oidc
OIDC_POST_LOGOUT_REDIRECT_URI=https://pulse.campus.ciencias.ulisboa.pt/
OIDC_STUDENT_ID_CLAIM=student_id
# Optional unless OIDC_TEACHER_GROUPS is configured. Dotted claim paths are supported.
OIDC_TEACHER_GROUP_CLAIM=groups
OIDC_TEACHER_GROUPS=teachers
AUTH_SESSION_SECRET=generate-at-least-32-random-characters
# Required on the university server. Use an absolute path on persistent local storage.
# PULSE_DATABASE_PATH=/var/lib/pulse/pulse.sqlite
